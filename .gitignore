# ==============================================================================
# Build Artifacts (Binaries and Objects)
# ==============================================================================
[Bb]in/
[Oo]bj/
cmake-build-*/

# ==============================================================================
# IDE & Editor Specific Files (Do not commit these)
# ==============================================================================
# Visual Studio
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# (Note: You might want to ignore launch.json if it contains secrets, 
#  but usually it's good to share launch configs)

# JetBrains Rider
.idea/
*.sln.iml

# ==============================================================================
# Secrets & Environment Variables (CRITICAL)
# ==============================================================================
# Ignore local development settings that might contain DB passwords
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
firebase-credentials.json
# Environment variable files
.env
.env.local

# User secrets (Generated by dotnet user-secrets)
secrets.json

# ==============================================================================
# Nuget & Packages
# ==============================================================================
*.nupkg
# The packages folder can be ignored because NuGet restores them
packages/
# Lock files are debatable, but often committed. Uncomment to ignore:
# project.lock.json

# ==============================================================================
# Testing & Coverage
# ==============================================================================
TestResults/
*.trx
coverage.json
coverage.xml
*.coverage
*.cobertura.xml

# ==============================================================================
# Operating System Files
# ==============================================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Mac
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ==============================================================================
# Logs & Crash Dumps
# ==============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.ps1
